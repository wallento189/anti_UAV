<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autoaim_bringup</name>
  <version>0.1.0</version>
  <description>System bringup: camera and detector components in one container with intra-process zero copy</description>
  <maintainer email="walt@todo.todo">walt</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>autoaim_camera</exec_depend>
  <exec_depend>autoaim_detector</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
